# ==============================================================================
#  ai editing - environment
#
#  Copy to .env and fill in. .env is never committed; this file is.
#  Anything marked FILL IN comes from a vendor console and must not be guessed.
# ==============================================================================

# --- storage ------------------------------------------------------------------
AIVE_DB_URL=sqlite:///./data/aive.db
AIVE_STORAGE_BACKEND=tos
AIVE_STORAGE_ROOT=./data/storage
AIVE_FFMPEG_BIN=ffmpeg
AIVE_FFPROBE_BIN=ffprobe

# Volcengine TOS credentials for the project-scoped media StorageProvider.
# Use local instead when an offline filesystem-only development run is needed.
# The IAM user is restricted to the aive-video-editor resource project.
AIVE_TOS_ENDPOINT=https://tos-cn-beijing.volces.com
AIVE_TOS_REGION=cn-beijing
AIVE_TOS_BUCKET=aive-video-editor-demo-7352987798276051244
# FILL IN with the AccessKey ID shown once on the IAM user creation page.
AIVE_TOS_ACCESS_KEY_ID=
# FILL IN with the matching SecretAccessKey. Never commit the populated value.
AIVE_TOS_SECRET_ACCESS_KEY=

# --- which model serves which role --------------------------------------------
#  The catalogue lives in packages/aive/model_registry.py (CATALOG), and the
#  current selection is ACTIVE_STACK there. The variables below override that
#  selection per role without editing code.
#
#  Values are catalogue keys, not vendor model names. List them with:
#      aive models
#
#  Model-authored understanding and editing do not have an offline keyword
#  fallback. If a selected provider is missing credentials, the Job fails
#  visibly. Local OpenCLIP is retained only as deterministic retrieval evidence.

# The checked-in ACTIVE_STACK already selects these keys. Uncomment only for
# an explicit bake-off override; do not copy vendor Model IDs into role fields.
# AIVE_ROLE_MATERIAL_MODEL=doubao-seed-2.1-lite
# AIVE_ROLE_STYLE_MODEL=doubao-seed-2.1-lite
# AIVE_ROLE_EMBEDDING_MODEL=doubao-embedding-vision-251215
# AIVE_ROLE_RERANK_MODEL=doubao-seed-2.1-lite
# AIVE_ROLE_DIRECTOR_MODEL=doubao-seed-2.1-pro
# AIVE_ROLE_REVIEWER_MODEL=doubao-seed-2.1-pro
# AIVE_ROLE_ASR_MODEL=seed-asr-2.0
# AIVE_ROLE_AUDIO_MODEL=doubao-seed-2.1-lite

# ==============================================================================
#  Volcengine Ark
# ==============================================================================
#  A single project-scoped Ark API Key can call every Ark model enabled for the
#  aive-video-editor project. Do not paste the separate Doubao Voice/Seed-ASR
#  key here.
#
#  Pro, Lite, and Embedding use pinned IDs in model_registry.py. One project key
#  authenticates all three, but every call persists the actual role and model.

AIVE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# FILL IN with the value of the Ark key named aive-video-editor-local-demo.
AIVE_ARK_API_KEY=

# ==============================================================================
#  Volcengine Doubao Voice - Seed-ASR 2.0
# ==============================================================================
#  Seed-ASR uses the separate key named aive-video-editor-seed-asr-demo and the
#  fixed X-Api-Resource-Id volc.seedasr.auc. It accepts a remotely fetchable
#  audio URL, so production media analysis also needs the TOS StorageProvider;
#  there is deliberately no chat-model transcription fallback.

AIVE_SEED_ASR_BASE_URL=https://openspeech.bytedance.com
# FILL IN with the separate Doubao Voice key, not the Ark key.
AIVE_SEED_ASR_API_KEY=

# ==============================================================================
#  Google Gemini
# ==============================================================================
# AIVE_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AIVE_GOOGLE_API_KEY=                    # FILL IN
# Pinned Director alternatives are declared in model_registry.py. Failover is
# limited to quota, timeout, and temporary capacity errors. Do not use rolling
# *-latest aliases.

# ==============================================================================
#  Others, unused so far
# ==============================================================================
# AIVE_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AIVE_BAILIAN_API_KEY=
# AIVE_OPENAI_BASE_URL=
# AIVE_OPENAI_API_KEY=

# --- logging -------------------------------------------------------------------
#  Every model call is appended to logs/ai-calls-YYYY-MM-DD.jsonl with the full
#  request and response. Read it with `aive logs`.
# AIVE_LOG_CALLS=1
# AIVE_LOG_DIR=logs

# --- generation defaults --------------------------------------------------------
# AIVE_CANDIDATE_COUNT=6
# AIVE_TOP_K_PROXY=3
# AIVE_SEED=41
