# ==============================================================================
#  ai editing - environment
#
#  Copy to .env and fill in. .env is never committed; this file is.
#  Anything marked FILL IN comes from a vendor console and must not be guessed.
# ==============================================================================

# --- storage ------------------------------------------------------------------
AIVE_DB_URL=sqlite:///./data/aive.db
AIVE_STORAGE_BACKEND=local
AIVE_STORAGE_ROOT=./data/storage
AIVE_FFMPEG_BIN=ffmpeg
AIVE_FFPROBE_BIN=ffprobe

# --- which model serves which role --------------------------------------------
#  The catalogue lives in packages/aive/model_registry.py (CATALOG), and the
#  current selection is ACTIVE_STACK there. The variables below override that
#  selection per role without editing code.
#
#  Values are catalogue keys, not vendor model names. List them with:
#      aive models
#
#  Everything defaults to offline implementations, so the pipeline runs with no
#  key and no cost until you point a role at a real model.

# AIVE_ROLE_MATERIAL_MODEL=doubao-vision-dev     # ← the one that matters now
# AIVE_ROLE_REFERENCE_MODEL=mock
# AIVE_ROLE_PLANNER_MODEL=mock
# AIVE_ROLE_EMBEDDING_MODEL=local-openclip-vitb32
# AIVE_ROLE_CRITIC_MODEL=passthrough
# AIVE_ROLE_AGENT_FAST_MODEL=mock
# AIVE_ROLE_AGENT_DEEP_MODEL=mock
# AIVE_ROLE_DIRECTOR_MODEL=doubao-vision  # Volcengine production endpoint
# AIVE_ROLE_REVIEWER_MODEL=doubao-vision  # rendered-preview multimodal review
# AIVE_ROLE_ASR_MODEL=qwen-asr              # requires Bailian settings below

# ==============================================================================
#  Volcengine Ark
# ==============================================================================
#  Two endpoints, on purpose.
#
#    doubao-vision-dev   enrolled in the reward plan  -> data IS shared
#    doubao-vision       not enrolled                 -> data is not shared
#
#  The reward plan buys free tokens with data authorisation. That is a fair
#  trade for our own test footage and a bad one for a user's holiday video, so
#  the split is enforced in code: sending user content through the dev endpoint
#  raises DataPolicyViolation rather than quietly succeeding.
#
#  On Ark the "model id" is usually an endpoint id (ep-...) that exists only in
#  your account, which is why it is set here rather than in the catalogue.

# AIVE_ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AIVE_ARK_API_KEY=                       # FILL IN
# AIVE_ARK_DEV_MODEL_ID=                  # FILL IN - the reward-plan endpoint
# AIVE_ARK_MODEL_ID=                      # FILL IN - the production endpoint

# ==============================================================================
#  Google Gemini
# ==============================================================================
# AIVE_GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AIVE_GOOGLE_API_KEY=                    # FILL IN

# ==============================================================================
#  Others, unused so far
# ==============================================================================
# AIVE_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AIVE_BAILIAN_API_KEY=
# AIVE_OPENAI_BASE_URL=
# AIVE_OPENAI_API_KEY=

# --- logging -------------------------------------------------------------------
#  Every model call is appended to logs/ai-calls-YYYY-MM-DD.jsonl with the full
#  request and response. Read it with `aive logs`.
# AIVE_LOG_CALLS=1
# AIVE_LOG_DIR=logs

# --- generation defaults --------------------------------------------------------
# AIVE_CANDIDATE_COUNT=6
# AIVE_TOP_K_PROXY=3
# AIVE_SEED=41
