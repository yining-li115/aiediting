# --- storage -----------------------------------------------------------------
AIVE_DB_URL=sqlite:///./data/aive.db
AIVE_MEDIA_ROOT=./data/media
AIVE_FFMPEG_BIN=ffmpeg
AIVE_FFPROBE_BIN=ffprobe

# --- model selection ---------------------------------------------------------
# Model choices live in ONE place: packages/aive/model_registry.py
#   CATALOG       every candidate, with capabilities, price and open unknowns
#   ACTIVE_STACK  the current selection - this is the line you edit to swap
#
# The variables below override ACTIVE_STACK per role without editing code.
# Values are catalog keys, not vendor model ids. Run `aive models` to list them.
# Everything defaults to offline implementations: no API key, no cost.
#
# AIVE_ROLE_MATERIAL_MODEL=qwen3.7-plus
# AIVE_ROLE_REFERENCE_MODEL=qwen3.7-plus
# AIVE_ROLE_PLANNER_MODEL=qwen3.7-plus
# AIVE_ROLE_EMBEDDING_MODEL=local-openclip-vitb32
# AIVE_ROLE_CRITIC_MODEL=qwen3-vl-8b-instruct
# AIVE_ROLE_AGENT_FAST_MODEL=mock
# AIVE_ROLE_ASR_MODEL=qwen-asr

# --- vendor credentials ------------------------------------------------------
# Each ModelCard names its own base_url_env / api_key_env, so business code
# never reads a key and adding a vendor never touches business code.
# Model ids in the catalog must be snapshot-pinned, never rolling aliases.
#
# After setting these, verify with one real call before trusting anything:
#   aive check-model --role material --frame path/to/frame.jpg
#
# AIVE_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# AIVE_BAILIAN_API_KEY=
# AIVE_ARK_BASE_URL=
# AIVE_ARK_API_KEY=
# AIVE_GOOGLE_BASE_URL=
# AIVE_GOOGLE_API_KEY=
# AIVE_OPENAI_BASE_URL=
# AIVE_OPENAI_API_KEY=
